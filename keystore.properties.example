# Release signing for the Android app. Copy this file to keystore.properties (git-ignored) and
# fill it in. Without keystore.properties, release builds are signed with the debug key.
#
# Create a key once with (keytool comes with the JDK):
#   keytool -genkeypair -v -keystore ~/keys/chofo-release.jks -alias chofo \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file and both passwords somewhere safe, with a backup: every future update has
# to be signed with this same key, and a lost key can't be recovered. Don't keep the .jks in
# the project folder, where a clean could delete it.

# Absolute path, or relative to androidApp/.
storeFile=/home/you/keys/chofo-release.jks
storePassword=
keyAlias=chofo
keyPassword=
