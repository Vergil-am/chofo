# Copy this file to secrets.properties (git-ignored) and fill in your values.
# Each key becomes a constant on dev.dogetime.Secrets, e.g. Secrets.TEST_API_KEY.
# Keys must be valid Kotlin identifiers.
TEST_API_KEY=your-test-key-here
TMDB_API_KEY=your-tmdb-key-here
SUBDL_API_KEY=your-subdl-key-here
OPEN_SUBTITLES_API_KEY=your-opensubtitles-key-here
# Simkl client id (public; no secret needed). Register a public app with AUTH V2 at
# https://simkl.com/settings/developer/ — leave blank to hide Simkl sync.
SIMKL_CLIENT_ID=
